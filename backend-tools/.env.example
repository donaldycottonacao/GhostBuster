# GhostBuster Backend Tools - Environment Configuration Template
# -----------------------------------------------------------------------------
# STATUS: NOT CURRENTLY CONSUMED. None of the scripts in scripts/ read a .env
# file or these variables (paths are resolved relative to the scripts, and options
# are command-line flags). The variables below are reserved for a future
# engine integration and have no effect today. You do not need to create .env.
#
# SECURITY NOTICE: Never commit real credentials, secret tokens, or private
# API keys into version control. If a future tool needs an API key, add it to
# your local, git-ignored .env only.
# -----------------------------------------------------------------------------

# Local Directories (reserved; currently unused)
VOICE_SAMPLES_DIR=voice_samples
OUTPUT_ASSETS_DIR=output_assets

# Speaker & Audio Authorization Settings (reserved; currently unused)
DEFAULT_SPEAKER_NAME=Alex
REQUIRE_EXPLICIT_CONSENT=true

# Text-to-Speech Engine Configuration (reserved; currently unused)
TTS_ENGINE=mock
DEFAULT_VOICE_MODEL=default_escort
AUDIO_SAMPLE_RATE=44100
AUDIO_OUTPUT_FORMAT=mp3

# Optional Logging (reserved; currently unused)
LOG_LEVEL=INFO
